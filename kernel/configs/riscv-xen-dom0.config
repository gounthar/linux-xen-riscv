##
## riscv-xen-dom0.config - Kconfig fragment turning xen_defconfig into a usable dom0
##
## Merge on top of arch/riscv/configs/xen_defconfig:
##   make ARCH=riscv xen_defconfig riscv-xen-dom0.config
##
## Measured 2026-09-20 against baptleduc/linux-xen-riscv 6.18-xen-guest-support:
## xen_defconfig sets XEN_BACKEND=y (the xenbus backend infrastructure) but
## neither of the two drivers that actually serve devices to a guest, so a dom0
## built from it can present no PV network and no PV disk. That is consistent
## with what the dom0less setup shows and it is not a dom0less limitation.

## --- the two backends, the whole point of this fragment ---
CONFIG_XEN_NETDEV_BACKEND=y
CONFIG_XEN_BLKDEV_BACKEND=y

## --- dom0 has to bridge the vif to something; =m is useless in a
##     module-less initrd, and xen_defconfig ships BRIDGE=m ---
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_LLC=y
CONFIG_STP=y
CONFIG_TUN=y

## --- the uplink QEMU gives dom0 ---
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y

## --- loopback/raw file backing for the domU disk ---
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8

## --- filesystems dom0 may need to host a disk image ---
CONFIG_EXT4_FS=y
